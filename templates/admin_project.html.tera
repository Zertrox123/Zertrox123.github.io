<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/static/style.css">
    <link rel="stylesheet" href="/static/admin.css">
</head>
<body>
    <div class="admin-container">
        <header class="admin-header">
            <h1>{{ title }}</h1>
            <div class="admin-nav">
                <a href="/admin/dashboard" class="nav-link">← Dashboard</a>
                <a href="/admin/logout" class="nav-link logout">Déconnexion</a>
            </div>
        </header>
        <form method="post" action="{{ action }}" class="project-form">
            <div class="form-row">
                <div class="form-group">
                    <label for="id">ID du projet* :</label>
                    <input type="text" id="id" name="id" value="{{ project.id | default(value="") }}"
                           {% if project %}readonly{% endif %} required>
                    <small>Unique, sans espaces (ex: mon-projet-cool)</small>
                </div>
                <div class="form-group">
                    <label for="name">Nom du projet* :</label>
                    <input type="text" id="name" name="name" value="{{ project.name | default(value="") }}" required>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="category">Catégorie* :</label>
                    <select id="category" name="category" required>
                        <option value="scolaire" selected>🎓 Scolaire</option>
                        <option value="personnel">💼 Personnel</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="date">Année* :</label>
                    <input type="text" id="date" name="date" value="{{ project.date | default(value="") }}"
                           placeholder="2024" required>
                </div>
            </div>

            <div class="form-group">
                <label for="description">Description courte* :</label>
                <textarea id="description" name="description" rows="2" required>{{ project.description | default(value="") }}</textarea>
                <small>Description qui apparaît sur la page d'accueil</small>
            </div>

            <div class="form-group">
                <label for="detailed_description">Description détaillée* :</label>
                <textarea id="detailed_description" name="detailed_description" rows="6" required>{{ project.detailed_description | default(value="") }}</textarea>
                <small>Description complète qui apparaît sur la page du projet</small>
            </div>

            <div class="form-group">
                <label for="technologies">Technologies* :</label>
                <input type="text" id="technologies" name="technologies"
                       value="{{ technologies_str | default(value="") }}" required>
                <small>Séparées par des virgules (ex: Python, C, MySQL)</small>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="github">Lien GitHub* :</label>
                    <input type="url" id="github" name="github" value="{{ project.github | default(value="") }}" required>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Créer le projet</button>
                <a href="/admin/dashboard" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
</body>
</html>