    <div id="no-projects-msg" style="display: none; text-align: center; color: #8b949e; padding: 3.5rem 1rem; font-family: 'Fira Code', monospace; font-size: 0.95rem; border: 1px dashed #30363d; border-radius: 8px; margin: 2rem 0;">
        Aucun projet ne correspond à ce filtre pour cette catégorie.
    </div>

    
    <div id="duckContainer" title="Clique-moi !">
        <div class="duck-sprite">
            <svg viewBox="0 0 64 64" width="56" height="56" style="display: block;">
                
                <ellipse cx="28" cy="42" rx="20" ry="14" fill="#facc15" />
                
                <path d="M10 40 Q4 32 8 28 Q14 34 18 38 Z" fill="#facc15" />
                
                <ellipse cx="26" cy="42" rx="10" ry="6" fill="#eab308" />
                
                <circle cx="44" cy="24" r="12" fill="#facc15" />
                
                <circle cx="48" cy="22" r="2.5" fill="#1e293b" />
                <circle cx="49" cy="21" r="0.8" fill="#ffffff" />
                
                <path d="M54 24 Q64 26 55 30 Z" fill="#f97316" />
                
                <ellipse cx="30" cy="56" rx="14" ry="2" fill="rgba(0, 0, 0, 0.3)" />
            </svg>
        </div>
    </div>

    <script>
    const toggle = document.getElementById('crazy-toggle');
    let crazyActive = false;

    let positions = Array.from(document.querySelectorAll('.project-card')).map(() => ({ x: 0, y: 0 }));

    function randomOffset(max = 2) {
        return Math.random() * max * 2 - max;
    }

    function animateProjects() {
        if (!crazyActive) return;

        const allCards = document.querySelectorAll('.project-card');
        allCards.forEach((proj, i) => {
            if (proj.style.display === 'none') return;
            if (!positions[i]) positions[i] = { x: 0, y: 0 };
            positions[i].x += randomOffset(1.5);
            positions[i].y += randomOffset(1.5);

            positions[i].x = Math.max(-20, Math.min(20, positions[i].x));
            positions[i].y = Math.max(-20, Math.min(20, positions[i].y));

            proj.style.transform = `translate(${positions[i].x}px, ${positions[i].y}px)`;
        });

        requestAnimationFrame(animateProjects);
    }

    toggle.addEventListener('change', () => {
        crazyActive = toggle.checked;

        if (crazyActive) {
            animateProjects();
        } else {
            document.querySelectorAll('.project-card').forEach((proj) => {
                proj.style.transform = 'translate(0px, 0px)';
            });
            positions = Array.from(document.querySelectorAll('.project-card')).map(() => ({ x: 0, y: 0 }));
        }
    });

    const categoryTabs = document.querySelectorAll('.nav-tab[data-category]');
    const projectSections = document.querySelectorAll('.project-section');
    const projectCards = document.querySelectorAll('.project-card');
    const filterToggleBtn = document.getElementById('filterToggleBtn');
    const filterDropdownMenu = document.getElementById('filterDropdownMenu');
    const filterOptions = document.querySelectorAll('.filter-option');
    const filterLabel = document.getElementById('filterLabel');

    let currentCategory = 'main';
    let currentLang = 'all';

    function applyFilters() {
        let totalVisibleCards = 0;
        let countMain = 0;
        let countTek1 = 0;
        let countTek2 = 0;
        let countPerso = 0;

        projectSections.forEach(section => {
            const cards = section.querySelectorAll('.project-card');
            let sectionVisibleCards = 0;

            cards.forEach(card => {
                const year = card.getAttribute('data-year');
                const isFeatured = card.getAttribute('data-featured') === 'true';
                const cardLangs = (card.getAttribute('data-lang') || '').split(',');

                const matchCat = (currentCategory === 'main' && isFeatured) ||
                                 (currentCategory === 'tek1' && year === 'tek1') ||
                                 (currentCategory === 'tek2' && year === 'tek2') ||
                                 (currentCategory === 'perso' && year === 'perso');

                const matchLang = (currentLang === 'all') || 
                                  cardLangs.includes(currentLang) ||
                                  (currentLang === 'js' && (cardLangs.includes('web') || cardLangs.includes('javascript')));

                if (matchCat && matchLang) {
                    card.style.display = '';
                    sectionVisibleCards++;
                    totalVisibleCards++;
                } else {
                    card.style.display = 'none';
                }

                if (matchLang) {
                    if (isFeatured) countMain++;
                    if (year === 'tek1') countTek1++;
                    if (year === 'tek2') countTek2++;
                    if (year === 'perso') countPerso++;
                }
            });

            section.style.display = (sectionVisibleCards > 0) ? '' : 'none';
        });

        const noProjectsMsg = document.getElementById('no-projects-msg');
        if (noProjectsMsg) {
            noProjectsMsg.style.display = (totalVisibleCards === 0) ? 'block' : 'none';
        }

        const elMain = document.getElementById('count-main');
        const elTek1 = document.getElementById('count-tek1');
        const elTek2 = document.getElementById('count-tek2');
        const elPerso = document.getElementById('count-perso');

        if (elMain) elMain.textContent = `(${countMain})`;
        if (elTek1) elTek1.textContent = `(${countTek1})`;
        if (elTek2) elTek2.textContent = `(${countTek2})`;
        if (elPerso) elPerso.textContent = `(${countPerso})`;

        if (history.replaceState) {
            history.replaceState(null, null, '#' + currentCategory);
        }
    }

    categoryTabs.forEach(tab => {
        tab.addEventListener('click', () => {
            currentCategory = tab.getAttribute('data-category');
            categoryTabs.forEach(t => t.classList.toggle('active', t === tab));
            applyFilters();
        });
    });

    if (filterToggleBtn && filterDropdownMenu) {
        filterToggleBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = filterDropdownMenu.classList.toggle('show');
            filterToggleBtn.classList.toggle('open', isOpen);
        });

        filterOptions.forEach(option => {
            option.addEventListener('click', (e) => {
                e.stopPropagation();
                currentLang = option.getAttribute('data-lang');
                filterOptions.forEach(opt => opt.classList.toggle('active', opt === option));
                
                filterLabel.textContent = 'Filtre';
                if (currentLang === 'all') {
                    filterToggleBtn.classList.remove('active-filter');
                } else {
                    filterToggleBtn.classList.add('active-filter');
                }

                filterDropdownMenu.classList.remove('show');
                filterToggleBtn.classList.remove('open');
                applyFilters();
            });
        });

        document.addEventListener('click', () => {
            filterDropdownMenu.classList.remove('show');
            filterToggleBtn.classList.remove('open');
        });
    }

    const currentHash = window.location.hash.replace('#', '');
    if (['main', 'tek1', 'tek2', 'perso'].includes(currentHash)) {
        currentCategory = currentHash;
        categoryTabs.forEach(t => t.classList.toggle('active', t.getAttribute('data-category') === currentCategory));
    }

    applyFilters();

    (function initDuck() {
        const duck = document.getElementById('duckContainer');
        if (!duck) return;

        let posX = window.innerWidth + 80;
        let posY = Math.random() * (window.innerHeight - 150) + 40;
        let direction = -1;
        let speed = 2.4;

        duck.style.top = posY + 'px';
        duck.style.left = posX + 'px';

        function setRandomY() {
            const maxY = Math.max(100, window.innerHeight - 120);
            posY = Math.random() * (maxY - 40) + 40;
            duck.style.top = posY + 'px';
        }

        function animateDuck() {
            posX += direction * speed;
            duck.style.left = posX + 'px';

            if (direction === -1 && posX < -100) {
                direction = 1;
                duck.style.transform = 'scaleX(-1)';
                setRandomY();
            } else if (direction === 1 && posX > window.innerWidth + 80) {
                direction = -1;
                duck.style.transform = 'scaleX(1)';
                setRandomY();
            }

            requestAnimationFrame(animateDuck);
        }

        requestAnimationFrame(animateDuck);

        function triggerQuack(e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }

            const rect = duck.getBoundingClientRect();
            const quack = document.createElement('span');
            quack.className = 'duck-quack-text';
            quack.textContent = 'Coin coin';

            const angle = (Math.random() * 60 - 30).toFixed(1);
            quack.style.setProperty('--rot', `${angle}deg`);
            quack.style.setProperty('--flip', direction === 1 ? 'scaleX(-1)' : 'scaleX(1)');

            const offsetX = (Math.random() * 30 - 15);
            const offsetY = (Math.random() * 20 - 10);
            quack.style.left = (rect.left + rect.width / 2 + offsetX) + 'px';
            quack.style.top = (rect.top + 15 + offsetY) + 'px';

            document.body.appendChild(quack);

            setTimeout(() => {
                if (quack.parentNode) {
                    quack.parentNode.removeChild(quack);
                }
            }, 460);
        }

        duck.addEventListener('pointerdown', triggerQuack);

        window.addEventListener('resize', () => {
            if (posY > window.innerHeight - 100) setRandomY();
        });
    })();
    </script>
</body>
</html>