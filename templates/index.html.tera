<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/static/style.css?v=5">
    <link rel="stylesheet" href="/static/responsive.css?v=5">
    <style>
    /* ==========================================
       MAIN HEADER & CRAZY SWITCH
       ========================================== */
    .main-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-bottom: 1.2rem;
        width: 100%;
    }

    .main-header h1 {
        margin: 0;
        font-size: 2rem;
    }

    .crazy-switch {
        position: static !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 0.5rem !important;
        font-family: 'Fira Code', monospace;
        font-size: 0.95rem;
        color: #c9d1d9;
        user-select: none;
        margin: 0 !important;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
        flex-shrink: 0;
    }

    .switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: #555;
        transition: .3s;
        border-radius: 24px;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: .3s;
        border-radius: 50%;
    }

    input:checked + .slider {
        background-color: #2ea043;
    }

    input:checked + .slider:before {
        transform: translateX(20px);
    }

    @media (max-width: 640px) {
        .main-header {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .main-header h1 {
            font-size: 1.35rem;
            line-height: 1.3;
        }

        .crazy-switch {
            font-size: 0.8rem !important;
            gap: 0.4rem !important;
        }

        .switch {
            width: 36px !important;
            height: 20px !important;
        }

        .slider:before {
            height: 14px !important;
            width: 14px !important;
            left: 3px !important;
            bottom: 3px !important;
        }

        input:checked + .slider:before {
            transform: translateX(16px) !important;
        }
    }

    /* ==========================================
       RANDOM 2D WANDERING DUCK WITH LARGE HITBOX
       ========================================== */
    #duckContainer {
        position: fixed;
        z-index: 99999;
        cursor: pointer;
        user-select: none;
        pointer-events: auto;
        will-change: left, top, transform;
        padding: 30px;
        margin: -30px;
        touch-action: manipulation;
    }

    .duck-sprite {
        display: inline-block;
        animation: duck-waddle 0.4s ease-in-out infinite alternate;
        filter: drop-shadow(0 6px 12px rgba(0,0,0,0.6));
    }

    @keyframes duck-waddle {
        0% {
            transform: translateY(0) rotate(-6deg);
        }
        100% {
            transform: translateY(-8px) rotate(6deg);
        }
    }

    .duck-quack-text {
        position: absolute;
        pointer-events: none;
        font-style: italic;
        font-size: 0.75rem;
        font-family: 'Fira Code', monospace;
        color: #ffffff;
        white-space: nowrap;
        user-select: none;
        z-index: 100000;
    }
    </style>
</head>
<body>
    <header class="main-header">
        <h1>~/Portfolio_<span class="accent">dev</span></h1>
        <div class="crazy-switch">
            <label class="switch">
                <input type="checkbox" id="crazy-toggle">
                <span class="slider round"></span>
            </label>
            <span>Crazy Mode</span>
        </div>
    </header>

    <p style="margin-bottom: 1.5rem;">
        Salut, je suis <b>{{ username }}</b>, un étudiant passionné par
        <span class="dynamic-lang">
            <span class="ticker">
                <span class="word">Python</span>
                <span class="word">C</span>
                <span class="word">Git</span>
                <span class="word">MySQL</span>
                <span class="word">Linux</span>
                <span class="word">Rust</span>
            </span>
        </span>
    </p>

    <!-- Category Filter Tabs -->
    <nav class="category-nav">
        <button class="nav-tab active" data-category="all">Tous les projets</button>
        <button class="nav-tab" data-category="tek1">Projet année 1 (tek 1)</button>
        <button class="nav-tab" data-category="tek2">Projet année 2 (tek 2)</button>
        <button class="nav-tab" data-category="perso">Projet perso</button>
    </nav>

    <section class="project-section" data-section="systemes">
        <h2>Systèmes & Concurrence</h2>
        <div class="projects-container">
            {% for project in projects %}
                {% if project.category == "systemes" %}
                    {% set p_year = "tek2" %}
                    {% if project.id == "my-top" or project.id == "my-sudo" %}
                        {% set p_year = "tek1" %}
                    {% endif %}
                    <a href="/project/{{ project.id }}" class="project-card" data-year="{{ p_year }}">
                        <h3>{{ project.name }}</h3>
                        <p>{{ project.description }}</p>
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    </section>

    <section class="project-section" data-section="ia">
        <h2>Intelligence Artificielle & Data</h2>
        <div class="projects-container">
            {% for project in projects %}
                {% if project.category == "ia" %}
                    <a href="/project/{{ project.id }}" class="project-card" data-year="tek2">
                        <h3>{{ project.name }}</h3>
                        <p>{{ project.description }}</p>
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    </section>

    <section class="project-section" data-section="outils">
        <h2>Outils & Web</h2>
        <div class="projects-container">
            {% for project in projects %}
                {% if project.category == "web_outils" or project.category == "scolaire" %}
                    {% set p_year = "tek2" %}
                    {% if project.id == "my-hunter" %}
                        {% set p_year = "tek1" %}
                    {% endif %}
                    <a href="/project/{{ project.id }}" class="project-card" data-year="{{ p_year }}">
                        <h3>{{ project.name }}</h3>
                        <p>{{ project.description }}</p>
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    </section>

    <section class="project-section" data-section="perso">
        <h2>Projets Perso</h2>
        <div class="projects-container">
            {% for project in projects %}
                {% if project.category == "personnel" %}
                    <a href="/project/{{ project.id }}" class="project-card" data-year="perso">
                        <h3>{{ project.name }}</h3>
                        <p>{{ project.description }}</p>
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    </section>

    <!-- Walking Duck across the screen at random Y coordinate -->
    <div id="duckContainer" title="Clique-moi !">
        <div class="duck-sprite">
            <svg viewBox="0 0 64 64" width="56" height="56" style="display: block;">
                <!-- Corps du canard -->
                <ellipse cx="28" cy="42" rx="20" ry="14" fill="#facc15" />
                <!-- Queue -->
                <path d="M10 40 Q4 32 8 28 Q14 34 18 38 Z" fill="#facc15" />
                <!-- Aile -->
                <ellipse cx="26" cy="42" rx="10" ry="6" fill="#eab308" />
                <!-- Tête -->
                <circle cx="44" cy="24" r="12" fill="#facc15" />
                <!-- Oeil -->
                <circle cx="48" cy="22" r="2.5" fill="#1e293b" />
                <circle cx="49" cy="21" r="0.8" fill="#ffffff" />
                <!-- Bec -->
                <path d="M54 24 Q64 26 55 30 Z" fill="#f97316" />
                <!-- Pattes / Ombre -->
                <ellipse cx="30" cy="56" rx="14" ry="2" fill="rgba(0, 0, 0, 0.3)" />
            </svg>
        </div>
    </div>

    <script>
    // ==========================================
    // CRAZY MODE TOGGLE
    // ==========================================
    const toggle = document.getElementById('crazy-toggle');
    let crazyActive = false;

    let positions = Array.from(document.querySelectorAll('.project-card')).map(() => ({ x: 0, y: 0 }));

    function randomOffset(max = 2) {
        return Math.random() * max * 2 - max;
    }

    function animateProjects() {
        if (!crazyActive) return;

        const allCards = document.querySelectorAll('.project-card');
        allCards.forEach((proj, i) => {
            if (proj.style.display === 'none') return;
            if (!positions[i]) positions[i] = { x: 0, y: 0 };
            positions[i].x += randomOffset(1.5);
            positions[i].y += randomOffset(1.5);

            positions[i].x = Math.max(-20, Math.min(20, positions[i].x));
            positions[i].y = Math.max(-20, Math.min(20, positions[i].y));

            proj.style.transform = `translate(${positions[i].x}px, ${positions[i].y}px)`;
        });

        requestAnimationFrame(animateProjects);
    }

    toggle.addEventListener('change', () => {
        crazyActive = toggle.checked;

        if (crazyActive) {
            animateProjects();
        } else {
            document.querySelectorAll('.project-card').forEach((proj) => {
                proj.style.transform = 'translate(0px, 0px)';
            });
            positions = Array.from(document.querySelectorAll('.project-card')).map(() => ({ x: 0, y: 0 }));
        }
    });

    // ==========================================
    // CATEGORY NAVIGATOR / FILTER
    // ==========================================
    const navTabs = document.querySelectorAll('.nav-tab');
    const projectCards = document.querySelectorAll('.project-card');
    const projectSections = document.querySelectorAll('.project-section');

    function filterCategory(category) {
        navTabs.forEach(tab => {
            if (tab.getAttribute('data-category') === category) {
                tab.classList.add('active');
            } else {
                tab.classList.remove('active');
            }
        });

        projectSections.forEach(section => {
            const cards = section.querySelectorAll('.project-card');
            let sectionVisibleCards = 0;

            cards.forEach(card => {
                const year = card.getAttribute('data-year');
                if (category === 'all' || year === category) {
                    card.style.display = '';
                    sectionVisibleCards++;
                } else {
                    card.style.display = 'none';
                }
            });

            if (category === 'all') {
                section.style.display = '';
            } else {
                section.style.display = (sectionVisibleCards > 0) ? '' : 'none';
            }
        });

        if (history.replaceState) {
            history.replaceState(null, null, '#' + category);
        }
    }

    navTabs.forEach(tab => {
        tab.addEventListener('click', () => {
            const cat = tab.getAttribute('data-category');
            filterCategory(cat);
        });
    });

    const currentHash = window.location.hash.replace('#', '');
    if (['all', 'tek1', 'tek2', 'perso'].includes(currentHash)) {
        filterCategory(currentHash);
    }

    // ==========================================
    // WANDERING DUCK WITH LARGE TOUCH HITBOX
    // ==========================================
    (function initDuck() {
        const duck = document.getElementById('duckContainer');
        if (!duck) return;

        let posX = window.innerWidth + 80;
        let posY = Math.random() * (window.innerHeight - 150) + 40;
        let direction = -1;
        let speed = 2.4;

        duck.style.top = posY + 'px';
        duck.style.left = posX + 'px';

        function setRandomY() {
            const maxY = Math.max(100, window.innerHeight - 120);
            posY = Math.random() * (maxY - 40) + 40;
            duck.style.top = posY + 'px';
        }

        function animateDuck() {
            posX += direction * speed;
            duck.style.left = posX + 'px';

            if (direction === -1 && posX < -100) {
                direction = 1;
                duck.style.transform = 'scaleX(-1)';
                setRandomY();
            } else if (direction === 1 && posX > window.innerWidth + 80) {
                direction = -1;
                duck.style.transform = 'scaleX(1)';
                setRandomY();
            }

            requestAnimationFrame(animateDuck);
        }

        requestAnimationFrame(animateDuck);

        function triggerQuack(e) {
            if (e && e.type === 'pointerdown') {
                e.preventDefault();
            }
            const quack = document.createElement('span');
            quack.className = 'duck-quack-text';
            quack.textContent = 'Coin coin';

            const angle = Math.random() * 60 - 30;
            const startX = Math.random() * 80 - 40;
            const startY = Math.random() * 50 - 35;
            let currentX = startX;
            let currentY = startY;
            let scale = 0.6;
            let opacity = 1;

            quack.style.left = '50px';
            quack.style.top = '45px';
            quack.style.transform = `translate(${currentX}px, ${currentY}px) rotate(${angle}deg) scale(${scale})`;
            quack.style.opacity = opacity;

            duck.appendChild(quack);

            let frame = 0;
            const totalFrames = 26;

            function animateQuack() {
                frame++;
                const progress = frame / totalFrames;

                if (progress < 0.3) {
                    scale = 0.6 + (progress / 0.3) * 0.45;
                } else if (progress < 0.5) {
                    scale = 1.05 - ((progress - 0.3) / 0.2) * 0.05;
                } else {
                    opacity = 1 - ((progress - 0.5) / 0.5);
                }

                currentY -= 1.0;

                quack.style.transform = `translate(${currentX}px, ${currentY}px) rotate(${angle}deg) scale(${scale})`;
                quack.style.opacity = Math.max(0, opacity);

                if (frame < totalFrames) {
                    requestAnimationFrame(animateQuack);
                } else {
                    if (quack.parentNode) quack.parentNode.removeChild(quack);
                }
            }

            requestAnimationFrame(animateQuack);
        }

        duck.addEventListener('pointerdown', triggerQuack);

        window.addEventListener('resize', () => {
            if (posY > window.innerHeight - 100) setRandomY();
        });
    })();
    </script>
</body>
</html>