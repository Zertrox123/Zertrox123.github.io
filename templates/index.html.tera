<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/static/style.css">
    <link rel="stylesheet" href="/static/responsive.css">
    <style>
    /* ==========================================
       RANDOM 2D WANDERING DUCK
       ========================================== */
    #duckContainer {
        position: fixed;
        z-index: 99999;
        cursor: pointer;
        user-select: none;
        pointer-events: auto;
        will-change: left, top, transform;
    }

    .duck-sprite {
        display: inline-block;
        animation: duck-waddle 0.4s ease-in-out infinite alternate;
        filter: drop-shadow(0 6px 12px rgba(0,0,0,0.6));
    }

    @keyframes duck-waddle {
        0% {
            transform: translateY(0) rotate(-6deg);
        }
        100% {
            transform: translateY(-8px) rotate(6deg);
        }
    }

    .duck-quack-text {
        position: absolute;
        pointer-events: none;
        font-style: italic;
        font-size: 0.78rem;
        font-family: 'Fira Code', monospace;
        color: #58a6ff;
        white-space: nowrap;
        user-select: none;
        z-index: 100000;
    }
    </style>
</head>
<body>
    <header class="main-header">
        <h1>~/Portfolio_<span class="accent">dev</span> 🚀</h1>
    </header>
    <div class="crazy-switch">
        <label class="switch">
            <input type="checkbox" id="crazy-toggle">
            <span class="slider round"></span>
        </label>
        <span>Crazy Mode</span>
    </div>
    <p>
        Salut, je suis <b>{{ username }}</b>, un étudiant passionné par
        <span class="dynamic-lang">
            <span class="ticker">
                <span class="word">Python</span>
                <span class="word">C</span>
                <span class="word">Git</span>
                <span class="word">MySQL</span>
                <span class="word">Linux</span>
                <span class="word">Rust</span>
            </span>
        </span>
    </p>

    <h2>⚡ Systèmes & Concurrence</h2>
    <div class="projects-container">
    {% for project in projects %}
        {% if project.category == "systemes" %}
        <a href="/project/{{ project.id }}" class="project-card">
            <h3>{{ project.name }}</h3>
            <p>{{ project.description }}</p>
        </a>
        {% endif %}
    {% endfor %}
    </div>

    <h2>🤖 Intelligence Artificielle & Data</h2>
    <div class="projects-container">
    {% for project in projects %}
        {% if project.category == "ia" %}
        <a href="/project/{{ project.id }}" class="project-card">
            <h3>{{ project.name }}</h3>
            <p>{{ project.description }}</p>
        </a>
        {% endif %}
    {% endfor %}
    </div>

    <h2>🛠️ Outils & Web</h2>
    <div class="projects-container">
    {% for project in projects %}
        {% if project.category == "web_outils" %}
        <a href="/project/{{ project.id }}" class="project-card">
            <h3>{{ project.name }}</h3>
            <p>{{ project.description }}</p>
        </a>
        {% endif %}
    {% endfor %}
    </div>

    <h2>💼 Projets Perso</h2>
    <div class="projects-container">
    {% for project in projects %}
        {% if project.category == "personnel" %}
        <a href="/project/{{ project.id }}" class="project-card">
            <h3>{{ project.name }}</h3>
            <p>{{ project.description }}</p>
        </a>
        {% endif %}
    {% endfor %}
    </div>

    <!-- Walking Duck across the screen at random Y coordinate -->
    <div id="duckContainer" title="Clique-moi ! 🦆">
        <div class="duck-sprite">
            <svg viewBox="0 0 64 64" width="56" height="56" style="display: block;">
                <!-- Corps du canard -->
                <ellipse cx="28" cy="42" rx="20" ry="14" fill="#facc15" />
                <!-- Queue -->
                <path d="M10 40 Q4 32 8 28 Q14 34 18 38 Z" fill="#facc15" />
                <!-- Aile -->
                <ellipse cx="26" cy="42" rx="10" ry="6" fill="#eab308" />
                <!-- Tête -->
                <circle cx="44" cy="24" r="12" fill="#facc15" />
                <!-- Oeil -->
                <circle cx="48" cy="22" r="2.5" fill="#1e293b" />
                <circle cx="49" cy="21" r="0.8" fill="#ffffff" />
                <!-- Bec -->
                <path d="M54 24 Q64 26 55 30 Z" fill="#f97316" />
                <!-- Pattes / Ombre -->
                <ellipse cx="30" cy="56" rx="14" ry="2" fill="rgba(0, 0, 0, 0.3)" />
            </svg>
        </div>
    </div>

    <script>
    const toggle = document.getElementById('crazy-toggle');
    const projects = document.querySelectorAll('.project-card');
    let crazyActive = false;

    const positions = Array.from(projects).map(() => ({ x: 0, y: 0 }));

    function randomOffset(max = 2) {
        return Math.random() * max * 2 - max;
    }
    function animateProjects() {
        if (!crazyActive) return;

        projects.forEach((proj, i) => {
            positions[i].x += randomOffset();
            positions[i].y += randomOffset();
            proj.style.transform = `translate(${positions[i].x}px, ${positions[i].y}px)`;
        });

        requestAnimationFrame(animateProjects);
    }
    toggle.addEventListener('change', () => {
        crazyActive = toggle.checked;

        if (crazyActive) {
            animateProjects();
        } else {
            positions.forEach(pos => { pos.x = 0; pos.y = 0; });
            projects.forEach(proj => proj.style.transform = 'translate(0,0)');
        }
    });

    // Wandering Duck Animation with Random Y Coordinate across whole screen
    (function() {
        const duck = document.getElementById('duckContainer');
        if (!duck) return;

        let posX = window.innerWidth + 80;
        let posY = Math.random() * (window.innerHeight - 150) + 40;
        let direction = -1; // -1: left, 1: right
        let speed = 2.4;

        duck.style.top = posY + 'px';
        duck.style.left = posX + 'px';

        function setRandomY() {
            const maxY = Math.max(100, window.innerHeight - 120);
            posY = Math.random() * (maxY - 40) + 40;
            duck.style.top = posY + 'px';
        }

        function animateDuck() {
            posX += direction * speed;
            duck.style.left = posX + 'px';

            if (direction === -1 && posX < -100) {
                direction = 1;
                duck.style.transform = 'scaleX(-1)';
                setRandomY();
            } else if (direction === 1 && posX > window.innerWidth + 80) {
                direction = -1;
                duck.style.transform = 'scaleX(1)';
                setRandomY();
            }

            requestAnimationFrame(animateDuck);
        }

        requestAnimationFrame(animateDuck);

        // Click interaction: Pure JS animation for small italic "Coin coin"
        duck.addEventListener('click', () => {
            const quack = document.createElement('span');
            quack.className = 'duck-quack-text';
            quack.textContent = 'Coin coin';

            const startX = (Math.random() - 0.5) * 70; // -35px to +35px
            const startY = -15 - Math.random() * 25;   // -15px to -40px
            let currentX = startX;
            let currentY = startY;
            let scale = 0.5;
            let opacity = 1;

            quack.style.left = '20px';
            quack.style.top = '10px';
            quack.style.transform = `translate(${currentX}px, ${currentY}px) scale(${scale})`;
            quack.style.opacity = opacity;

            duck.appendChild(quack);

            let frame = 0;
            const totalFrames = 45; // ~750ms

            function animateQuack() {
                frame++;
                const progress = frame / totalFrames;

                // Pop-in scale
                if (progress < 0.25) {
                    scale = 0.5 + (progress / 0.25) * 0.6; // 0.5 -> 1.1
                } else if (progress < 0.4) {
                    scale = 1.1 - ((progress - 0.25) / 0.15) * 0.1; // 1.1 -> 1.0
                } else {
                    opacity = 1 - ((progress - 0.4) / 0.6); // fade out
                }

                currentY -= 0.6; // float upwards smoothly

                quack.style.transform = `translate(${currentX}px, ${currentY}px) scale(${scale})`;
                quack.style.opacity = Math.max(0, opacity);

                if (frame < totalFrames) {
                    requestAnimationFrame(animateQuack);
                } else {
                    if (quack.parentNode) quack.parentNode.removeChild(quack);
                }
            }

            requestAnimationFrame(animateQuack);
        });

        window.addEventListener('resize', () => {
            if (posY > window.innerHeight - 100) setRandomY();
        });
    })();
    </script>
</body>
</html>