    <section class="project-section" data-section="graphisme">
        <h2>Graphisme 2D/3D & Jeux</h2>
        <div class="projects-container">
            <a href="/project/my-hunter" class="project-card" data-year="tek1" data-lang="c">
                <h3>My Hunter</h3>
                <p>Mini-jeu graphique 2D en C avec la bibliothèque CSFML</p>
            </a>
            <a href="/project/myradar" class="project-card" data-year="tek1" data-lang="c">
                <h3>My Radar</h3>
