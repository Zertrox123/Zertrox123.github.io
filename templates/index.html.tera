<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/static/style.css">
    <link rel="stylesheet" href="/static/responsive.css">
</head>
<body>
    <header class="main-header">
        <h1>~/Portfolio_<span class="accent">dev</span> 🚀</h1>
    </header>
    <div class="crazy-switch">
        <label class="switch">
            <input type="checkbox" id="crazy-toggle">
            <span class="slider round"></span>
        </label>
        <span>Crazy Mode</span>
    </div>
    <p>
        Salut, je suis <b>{{ username }}</b>, un étudiant passionné par
        <span class="dynamic-lang">
            <span class="ticker">
                <span class="word">Python</span>
                <span class="word">C</span>
                <span class="word">Git</span>
                <span class="word">MySQL</span>
                <span class="word">Linux</span>
                <span class="word">Rust</span>
            </span>
        </span>
    </p>
    <h2>⚡ Systèmes & Concurrence</h2>
    <div class="projects-container">
    {% for project in projects %}
        {% if project.category == "systemes" %}
        <a href="/project/{{ project.id }}" class="project-card">
            <h3>{{ project.name }}</h3>
            <p>{{ project.description }}</p>
        </a>
        {% endif %}
    {% endfor %}
    </div>

    <h2>🤖 Intelligence Artificielle & Data</h2>
    <div class="projects-container">
    {% for project in projects %}
        {% if project.category == "ia" %}
        <a href="/project/{{ project.id }}" class="project-card">
            <h3>{{ project.name }}</h3>
            <p>{{ project.description }}</p>
        </a>
        {% endif %}
    {% endfor %}
    </div>

    <h2>🛠️ Outils & Web</h2>
    <div class="projects-container">
    {% for project in projects %}
        {% if project.category == "web_outils" %}
        <a href="/project/{{ project.id }}" class="project-card">
            <h3>{{ project.name }}</h3>
            <p>{{ project.description }}</p>
        </a>
        {% endif %}
    {% endfor %}
    </div>

    <h2>💼 Projets Perso</h2>
    <div class="projects-container">
    {% for project in projects %}
        {% if project.category == "personnel" %}
        <a href="/project/{{ project.id }}" class="project-card">
            <h3>{{ project.name }}</h3>
            <p>{{ project.description }}</p>
        </a>
        {% endif %}
    {% endfor %}
    </div>
    <script>
    const toggle = document.getElementById('crazy-toggle');
    const projects = document.querySelectorAll('.project-card');
    let crazyActive = false;

    const positions = Array.from(projects).map(() => ({ x: 0, y: 0 }));

    function randomOffset(max = 2) {
        return Math.random() * max * 2 - max;
    }
    function animateProjects() {
        if (!crazyActive) return;

        projects.forEach((proj, i) => {
            positions[i].x += randomOffset();
            positions[i].y += randomOffset();
            proj.style.transform = `translate(${positions[i].x}px, ${positions[i].y}px)`;
        });

        requestAnimationFrame(animateProjects);
    }
    toggle.addEventListener('change', () => {
        crazyActive = toggle.checked;

        if (crazyActive) {
            animateProjects();
        } else {
            positions.forEach(pos => { pos.x = 0; pos.y = 0; });
            projects.forEach(proj => proj.style.transform = 'translate(0,0)');
        }
    });

    const duck = document.getElementById('duckContainer');
    const bubble = document.getElementById('duckBubble');
    if (duck && bubble) {
        duck.addEventListener('click', () => {
            bubble.classList.add('show');
            setTimeout(() => bubble.classList.remove('show'), 2000);
        });
    }
    </script>

    <!-- Walking Duck -->
    <div class="walking-duck-container" id="duckContainer" title="Coin coin ! 🦆">
        <div class="duck">
            <span class="duck-bubble" id="duckBubble">Coin coin ! 🦆</span>
            <svg viewBox="0 0 64 64" width="48" height="48" style="display: block;">
                <ellipse cx="28" cy="42" rx="20" ry="14" fill="#facc15" />
                <path d="M10 40 Q4 32 8 28 Q14 34 18 38 Z" fill="#facc15" />
                <ellipse cx="26" cy="42" rx="10" ry="6" fill="#eab308" />
                <circle cx="44" cy="24" r="12" fill="#facc15" />
                <circle cx="48" cy="22" r="2.5" fill="#1e293b" />
                <circle cx="49" cy="21" r="0.8" fill="#ffffff" />
                <path d="M54 24 Q64 26 55 30 Z" fill="#f97316" />
                <ellipse cx="30" cy="56" rx="14" ry="2" fill="rgba(88, 166, 255, 0.2)" />
            </svg>
        </div>
    </div>
</body>
</html>