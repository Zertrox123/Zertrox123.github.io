<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/static/style.css?v=8">
    <link rel="stylesheet" href="/static/responsive.css?v=8">
    <style>
    
    .main-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-bottom: 1.2rem;
        width: 100%;
    }

    .main-header h1 {
        margin: 0;
        font-size: 2rem;
    }

    .crazy-switch {
        position: static !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 0.5rem !important;
        font-family: 'Fira Code', monospace;
        font-size: 0.95rem;
        color: #c9d1d9;
        user-select: none;
        margin: 0 !important;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
        flex-shrink: 0;
    }

    .switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: #555;
        transition: .3s;
        border-radius: 24px;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: .3s;
        border-radius: 50%;
    }

    input:checked + .slider {
        background-color: #2ea043;
    }

    input:checked + .slider:before {
        transform: translateX(20px);
    }

    @media (max-width: 640px) {
        .main-header {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .main-header h1 {
            font-size: 1.35rem;
            line-height: 1.3;
        }

        .crazy-switch {
            font-size: 0.8rem !important;
            gap: 0.4rem !important;
        }

        .switch {
            width: 36px !important;
            height: 20px !important;
        }

        .slider:before {
            height: 14px !important;
            width: 14px !important;
            left: 3px !important;
            bottom: 3px !important;
        }

        input:checked + .slider:before {
            transform: translateX(16px) !important;
        }
    }

    
    #duckContainer {
        position: fixed;
        z-index: 99999;
        cursor: pointer;
        user-select: none;
        pointer-events: auto;
        will-change: left, top, transform;
        padding: 30px;
        margin: -30px;
        touch-action: manipulation;
    }

    .duck-sprite {
        display: inline-block;
        animation: duck-waddle 0.4s ease-in-out infinite alternate;
        filter: drop-shadow(0 6px 12px rgba(0,0,0,0.6));
    }

    .duck-quack-text {
        position: fixed;
        z-index: 100000;
        pointer-events: none;
        user-select: none;
        font-family: 'Fira Code', monospace;
        font-size: 0.85rem;
        font-style: italic;
        color: #ffffff;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9);
        white-space: nowrap;
        animation: quack-fast 0.45s ease-out forwards;
    }

    @keyframes quack-fast {
        0% {
            opacity: 0;
            transform: translate(-50%, 0) var(--flip, scaleX(1)) rotate(var(--rot, 0deg)) scale(0.6);
        }
        25% {
            opacity: 1;
            transform: translate(-50%, -12px) var(--flip, scaleX(1)) rotate(var(--rot, 0deg)) scale(1.1);
        }
        50% {
            opacity: 1;
            transform: translate(-50%, -22px) var(--flip, scaleX(1)) rotate(var(--rot, 0deg)) scale(1);
        }
        100% {
            opacity: 0;
            transform: translate(-50%, -40px) var(--flip, scaleX(1)) rotate(var(--rot, 0deg)) scale(0.9);
        }
    }

    
    .category-nav {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 1.5rem 0 2rem 0;
        border-bottom: 1px solid #30363d;
        padding-bottom: 1rem;
    }

    .nav-tab {
        background: #161b22;
        color: #8b949e;
        border: 1px solid #30363d;
        border-radius: 6px;
        padding: 0.5rem 0.95rem;
        font-family: 'Fira Code', monospace;
        font-size: 0.88rem;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
    }

    .nav-tab:hover {
        color: #c9d1d9;
        border-color: #58a6ff;
        background: #21262d;
    }

    .nav-tab.active {
        background: #1f6feb;
        color: #ffffff;
        border-color: #58a6ff;
        font-weight: bold;
    }

    .filter-dropdown-container {
        position: relative;
        display: inline-block;
    }

    .filter-btn {
        background: #161b22;
        color: #8b949e;
        border: 1px solid #30363d;
        border-radius: 6px;
        padding: 0.5rem 0.95rem;
        font-family: 'Fira Code', monospace;
        font-size: 0.88rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        user-select: none;
        transition: all 0.15s ease;
    }

    .filter-btn:hover, .filter-btn.open {
        color: #c9d1d9;
        border-color: #58a6ff;
        background: #21262d;
    }

    .filter-btn.active-filter {
        background: rgba(31, 111, 235, 0.2) !important;
        border-color: #58a6ff !important;
        color: #58a6ff !important;
        font-weight: bold;
    }

    .filter-btn.active-filter svg {
        stroke: #58a6ff !important;
    }

    .filter-btn.active-filter .dropdown-arrow {
        color: #58a6ff !important;
    }

    .filter-dropdown-menu {
        display: none !important;
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        left: auto;
        z-index: 99999;
        min-width: 190px;
        width: max-content;
        white-space: nowrap;
        background: #161b22;
        border: 1px solid #30363d;
        border-radius: 6px;
        padding: 0.35rem 0;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
    }

    .filter-dropdown-menu.show {
        display: block !important;
    }

    .filter-option {
        padding: 0.5rem 1rem;
        font-family: 'Fira Code', monospace;
        font-size: 0.84rem;
        color: #c9d1d9;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
        user-select: none;
    }

    .filter-option:hover {
        background: #21262d;
        color: #58a6ff;
    }

    .filter-option.active {
        background: rgba(31, 111, 235, 0.2);
        color: #58a6ff;
        font-weight: bold;
    }
    </style>
</head>
<body>
    <header class="main-header">
        <h1>~/Portfolio_<span class="accent">dev</span></h1>
        <div class="crazy-switch">
            <label class="switch">
                <input type="checkbox" id="crazy-toggle">
                <span class="slider round"></span>
            </label>
            <span>Crazy Mode</span>
        </div>
    </header>

    <p style="margin-bottom: 1.5rem;">
        Salut, je suis <b>{{ username }}</b>, un étudiant passionné par
        <span class="dynamic-lang">
            <span class="ticker">
                <span class="word">Python</span>
                <span class="word">C</span>
                <span class="word">Git</span>
                <span class="word">MySQL</span>
                <span class="word">Linux</span>
                <span class="word">Rust</span>
            </span>
        </span>
    </p>

    
    <nav class="category-nav">
        <button class="nav-tab active" data-category="main">Projets principaux <span id="count-main">(8)</span></button>
        <button class="nav-tab" data-category="tek1">Projet année 1 <span id="count-tek1">(18)</span></button>
        <button class="nav-tab" data-category="tek2">Projet année 2 <span id="count-tek2">(15)</span></button>
        <button class="nav-tab" data-category="perso">Projet perso <span id="count-perso">(9)</span></button>

        
        <div class="filter-dropdown-container">
            <button type="button" class="filter-btn" id="filterToggleBtn" title="Filtrer par langage">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                </svg>
                <span id="filterLabel">Filtre</span>
                <span class="dropdown-arrow">▾</span>
            </button>
            <div class="filter-dropdown-menu" id="filterDropdownMenu">
                <div class="filter-option active" data-lang="all">Tous les langages</div>
                <div class="filter-option" data-lang="c">C</div>
                <div class="filter-option" data-lang="cpp">C++</div>
                <div class="filter-option" data-lang="python">Python</div>
                <div class="filter-option" data-lang="rust">Rust</div>
                <div class="filter-option" data-lang="js">JavaScript / Web</div>
            </div>
        </div>
    </nav>

    
    <section class="project-section" data-section="systemes">
        <h2>Systèmes & Bas-Niveau</h2>
        <div class="projects-container">
            <a href="/project/zappy" class="project-card" data-year="tek2" data-featured="true" data-lang="c,cpp,python">
                <h3>Zappy</h3>
                <p>Jeu en réseau distribué : Serveur TCP en C, IA en C++/Python et client graphique</p>
            </a>
            <a href="/project/the-plazza" class="project-card" data-year="tek2" data-featured="true" data-lang="cpp">
                <h3>The Plazza & Panoramix</h3>
