<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/static/style.css">
    <link rel="stylesheet" href="/static/responsive.css">
</head>
<body>
    <header class="main-header">
        <h1>~/Portfolio_<span class="accent">dev</span> 🚀</h1>
        <a href="/admin/login" class="admin-login-btn">🔐 Admin</a>
    </header>
    <div class="crazy-switch">
        <label class="switch">
            <input type="checkbox" id="crazy-toggle">
            <span class="slider round"></span>
        </label>
        <span>Crazy Mode</span>
    </div>
    <p>
        Salut, je suis <b>{{ username }}</b>, un étudiant passionné par
        <span class="dynamic-lang">
            <span class="ticker">
                <span class="word">Python</span>
                <span class="word">C</span>
                <span class="word">Git</span>
                <span class="word">MySQL</span>
                <span class="word">Linux</span>
                <span class="word">Rust</span>
            </span>
        </span>
    </p>
    <h2>🎓 Projets Scolaires</h2>
    <div class="projects-container">
    {% for project in projects %}
        {% if project.category == "scolaire" %}
        <a href="/project/{{ project.id }}" class="project-card">
            <h3>{{ project.name }}</h3>
            <p>{{ project.description }}</p>
        </a>
        {% endif %}
    {% endfor %}
    </div>
    <h2>💼 Projets Perso</h2>
    <div class="projects-container">
    {% for project in projects %}
        {% if project.category == "personnel" %}
        <a href="/project/{{ project.id }}" class="project-card">
            <h3>{{ project.name }}</h3>
            <p>{{ project.description }}</p>
        </a>
        {% endif %}
    {% endfor %}
    </div>
    <script>
    const toggle = document.getElementById('crazy-toggle');
    const projects = document.querySelectorAll('.project-card');
    let crazyActive = false;

    const positions = Array.from(projects).map(() => ({ x: 0, y: 0 }));

    function randomOffset(max = 2) {
        return Math.random() * max * 2 - max;
    }
    function animateProjects() {
        if (!crazyActive) return;

        projects.forEach((proj, i) => {
            positions[i].x += randomOffset();
            positions[i].y += randomOffset();
            proj.style.transform = `translate(${positions[i].x}px, ${positions[i].y}px)`;
        });

        requestAnimationFrame(animateProjects);
    }
    toggle.addEventListener('change', () => {
        crazyActive = toggle.checked;

        if (crazyActive) {
            animateProjects();
        } else {
            positions.forEach(pos => { pos.x = 0; pos.y = 0; });
            projects.forEach(proj => proj.style.transform = 'translate(0,0)');
        }
    });
    </script>
</body>
</html>