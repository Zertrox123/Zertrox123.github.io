<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/static/style.css">
    <link rel="stylesheet" href="/static/admin.css">
</head>
<body>
    <div class="admin-container">
        <header class="admin-header">
            <h1>🛠️ Dashboard Admin</h1>
            <div class="admin-nav">
                <a href="/" class="nav-link">Voir le site</a>
                <a href="/admin/logout" class="nav-link logout">Déconnexion</a>
            </div>
        </header>

        <div class="admin-actions">
            <a href="/admin/project/new" class="btn btn-primary">➕ Nouveau Projet</a>
        </div>

        <div class="projects-admin">
            <h2>📋 Projets existants ({{ projects | length }})</h2>
            {% if projects %}
            <div class="admin-projects-grid">
                {% for project in projects %}
                <div class="admin-project-card">
                    <div class="project-info">
                        <h3>{{ project.name }}</h3>
                        <p class="project-id">ID: {{ project.id }}</p>
                        <p class="project-category category-{{ project.category }}">
                            {% if project.category == "scolaire" %}🎓 Scolaire{% else %}💼 Personnel{% endif %}
                        </p>
                        <p class="project-desc">{{ project.description }}</p>
                        <p class="project-date">{{ project.date }}</p>
                    </div>
                    <div class="project-actions">
                        <a href="/project/{{ project.id }}" class="btn btn-view" target="_blank">👁️ Voir</a>
                        <a href="/admin/project/{{ project.id }}/edit" class="btn btn-edit">✏️ Éditer</a>
                        <form method="post" action="/admin/project/{{ project.id }}/delete"
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce projet ?')" style="display: inline;">
                            <button type="submit" class="btn btn-delete">🗑️ Supprimer</button>
                        </form>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="no-projects">
                <p>Aucun projet pour le moment.</p>
                <a href="/admin/project/new" class="btn btn-primary">Créer le premier projet</a>
            </div>
            {% endif %}
        </div>
    </div>
</body>
</html>