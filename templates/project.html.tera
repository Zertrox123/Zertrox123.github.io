<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/static/style.css">
    <link rel="stylesheet" href="/static/responsive.css">
</head>
<body>
    <div class="project-detail">
        <div class="back-nav">
            <a href="/" class="back-link">← Retour au portfolio</a>
        </div>
        <header class="project-header">
            <h1>{{ project.name }}</h1>
            <div class="project-meta">
                <span class="project-date">{{ project.date }}</span>
                <span class="project-category category-{{ project.category }}">
                    {% if project.category == "systemes" %}⚡ Systèmes{% elif project.category == "ia" %}🤖 IA & Data{% elif project.category == "web_outils" %}🛠️ Outils & Web{% else %}💼 Personnel{% endif %}
                </span>
            </div>
        </header>
        <section class="project-content">
            <h2>📝 Description</h2>
            <p class="project-description">{{ project.detailed_description }}</p>

            <!-- Technologies utilisées -->
            <h2>🛠️ Technologies</h2>
            <div class="tech-tags">
                {% for tech in project.technologies %}
                    <span class="tech-tag">{{ tech }}</span>
                {% endfor %}
            </div>

            <!-- Liens -->
            <h2>🔗 Liens</h2>
            <div class="project-links">
                <a href="{{ project.github }}" target="_blank" class="project-link github-link">
                    📦 Voir sur GitHub
                </a>
            </div>
        </section>
    </div>

    <footer>
        © 2025 {{ username }} — Fait avec ❤️ et 🦀 Rocket
    </footer>
</body>
</html>